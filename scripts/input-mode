#!/usr/bin/env bash
set -euo pipefail

submap_name="horizon-vdi"
setup_expression='hl.define_submap("horizon-vdi", function() hl.bind("SUPER + CTRL + ESCAPE", hl.dsp.submap("reset"), { description = "Emergency restore Omarchy shortcuts" }) end)'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/horizon-input-mode"
log_file="$state_dir/activity.log"

log_event() {
  mkdir -p "$state_dir"
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log_file"
}

current_submap() {
  hyprctl submap | tr -d '\r\n'
}

setup_mode() {
  hyprctl repl "$setup_expression" >/dev/null
}

case "${1:-}" in
  setup)
    if setup_mode; then log_event "setup: submap registered"
    else log_event "setup: FAILED"; exit 1
    fi
    ;;
  on)
    log_event "toggle requested: on"
    setup_mode
    hyprctl dispatch 'hl.dsp.submap("horizon-vdi")' >/dev/null
    [[ "$(current_submap)" == "$submap_name" ]] || {
      log_event "toggle on: FAILED (submap=$(current_submap))"
      echo "Hyprland did not enter Horizon input mode." >&2
      exit 1
    }
    log_event "toggle on: verified submap=horizon-vdi"
    echo "Horizon now receives Alt+Tab and Super shortcuts."
    ;;
  off)
    log_event "toggle requested: off"
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    [[ "$(current_submap)" == "default" ]] || {
      log_event "toggle off: FAILED (submap=$(current_submap))"
      echo "Hyprland did not restore Omarchy shortcuts." >&2
      exit 1
    }
    log_event "toggle off: verified submap=default"
    echo "Omarchy shortcuts restored."
    ;;
  status)
    current_submap
    ;;
  log)
    if [[ -f "$log_file" ]]; then tail -n 40 "$log_file"
    else echo "No diagnostic events yet."
    fi
    ;;
  *)
    echo "Usage: input-mode {setup|on|off|status|log}" >&2
    exit 2
    ;;
esac
